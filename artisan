/**
 * php artisan down
 * Met le site en mode maintenance immédiat (bypass BDD)
 */
function cmdDown(array $options = []) {
    $dir = ensureStorageDir();
    $file = DOWN_FILE;
    
    // Récupérer les options
    $message   = $options['message']  ?? 'Site en maintenance. Nous reviendrons bientôt !';
    $retry     = (int)($options['retry']   ?? 60);
    $refresh   = (int)($options['refresh'] ?? 0);
    $secret    = $options['secret']   ?? null;
    $redirect  = $options['redirect'] ?? null;
    $status    = (int)($options['status']  ?? 503);
    
    // Gérer --allow (peut être multiple)
    $allowed = [];
    if (isset($options['allow'])) {
        if (is_array($options['allow'])) {
            $allowed = $options['allow'];
        } else {
            $allowed = array_map('trim', explode(',', $options['allow']));
        }
    }
    
    // Générer un secret si --secret est passé sans valeur
    if ($secret === true || $secret === '') {
        $secret = bin2hex(random_bytes(16));
    }
    
    // Construire le payload JSON
    $payload = [
        'time'      => time(),
        'message'   => $message,
        'retry'     => $retry,
        'refresh'   => $refresh,
        'status'    => $status,
        'allowed'   => $allowed,
        'redirect'  => $redirect,
        'template'  => null,
    ];
    
    // Fichier down
    if (file_put_contents($file, json_encode($payload, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE)) === false) {
        error("Impossible d'écrire le fichier : $file");
        return;
    }
    
    // Si secret : créer un cookie de bypass
    if ($secret) {
        $cookieFile = $dir . '/down-secret';
        file_put_contents($cookieFile, $secret);
    }
    
    // Affichage
    line();
    line(color('╔══════════════════════════════════════╗', 'yellow'));
    line(color('║  ', 'yellow') . color('🚧 SITE MIS HORS LIGNE', 'bold') . color('                ║', 'yellow'));
    line(color('╚══════════════════════════════════════╝', 'yellow'));
    line();
    success("Application en mode maintenance");
    line();
    line(color('Message   : ', 'gray') . $message);
    line(color('Retry     : ', 'gray') . $retry . 's');
    if ($refresh > 0) line(color('Refresh   : ', 'gray') . $refresh . 's');
    if (!empty($allowed)) line(color('IPs OK    : ', 'gray') . implode(', ', $allowed));
    if ($redirect) line(color('Redirect  : ', 'gray') . $redirect);
    line(color('Status    : ', 'gray') . $status);
    
    if ($secret) {
        line();
        line(color('🔑 Token de bypass :', 'cyan'));
        line(color('   ' . $secret, 'white'));
        line();
        line(color('Pour accéder au site pendant la maintenance :', 'gray'));
        line(color('   ' . (getenv('APP_URL') ?: 'https://...') . '/?secret=' . $secret, 'cyan'));
    }
    
    line();
    line(color('Pour réactiver : ', 'gray') . color('php artisan up', 'green'));
    line();
}

/**
 * php artisan up
 * Remet le site en ligne
 */
function cmdUp() {
    $file = DOWN_FILE;
    $secretFile = BASE_PATH . '/storage/framework/down-secret';
    
    if (!file_exists($file)) {
        warning("Le site est déjà en ligne (pas de fichier down)");
        return;
    }
    
    // Lire les infos avant suppression
    $payload = json_decode(file_get_contents($file), true);
    $downSince = isset($payload['time']) ? date('Y-m-d H:i:s', $payload['time']) : '?';
    $duration = isset($payload['time']) ? (time() - $payload['time']) : 0;
    
    // Supprimer les fichiers
    @unlink($file);
    @unlink($secretFile);
    
    // Vider le cache OPcache si dispo
    if (function_exists('opcache_reset')) {
        @opcache_reset();
    }
    
    line();
    line(color('╔══════════════════════════════════════╗', 'green'));
    line(color('║  ', 'green') . color('✅ SITE REMIS EN LIGNE', 'bold') . color('               ║', 'green'));
    line(color('╚══════════════════════════════════════╝', 'green'));
    line();
    success("Application de nouveau disponible");
    line();
    line(color('Hors ligne depuis : ', 'gray') . $downSince);
    line(color('Durée maintenance : ', 'gray') . formatDuration($duration));
    line();
}

function formatDuration($seconds) {
    if ($seconds < 60) return $seconds . 's';
    if ($seconds < 3600) return floor($seconds / 60) . 'min ' . ($seconds % 60) . 's';
    $h = floor($seconds / 3600);
    $m = floor(($seconds % 3600) / 60);
    return $h . 'h ' . $m . 'min';
}

// ═══════════════════════════════════════════
// STATUS (amélioré avec down/up)
// ═══════════════════════════════════════════
function cmdStatus() {
    line(color('╔══════════════════════════════════════╗', 'cyan'));
    line(color('║  Statut du système OrinHeberge       ║', 'white'));
    line(color('╚══════════════════════════════════════╝', 'cyan'));
    line();
    
    // Mode Down/Up
    if (file_exists(DOWN_FILE)) {
        $payload = json_decode(file_get_contents(DOWN_FILE), true);
        $downSince = isset($payload['time']) ? date('H:i:s', $payload['time']) : '?';
        line(color('🚧 Mode', 'yellow') . '      : ' . color('HORS LIGNE (down)', 'red') . color(" depuis $downSince", 'gray'));
    } else {
        line(color('🚧 Mode', 'yellow') . '      : ' . color('EN LIGNE (up)', 'green'));
    }
    
    // PHP
    $phpVersion = PHP_VERSION;
    line(color('PHP', 'yellow') . '        : ' . $phpVersion . ' ' . (version_compare($phpVersion, '8.1', '>=') ? color('✅', 'green') : color('❌', 'red')));
    
    // MySQL
    try {
        $pdo = getPdo();
        $version = $pdo->query("SELECT VERSION()")->fetchColumn();
        line(color('MySQL', 'yellow') . '      : ' . $version . ' ' . color('✅', 'green'));
        $count = $pdo->query("SELECT COUNT(*) FROM users")->fetchColumn();
        line(color('Users', 'yellow') . '      : ' . $count);
        $orders = $pdo->query("SELECT COUNT(*) FROM orders WHERE status = 'paid'")->fetchColumn();
        line(color('Serveurs', 'yellow') . '   : ' . $orders . ' actifs');
    } catch (Exception $e) {
        line(color('MySQL', 'yellow') . '      : ' . color('❌ ' . $e->getMessage(), 'red'));
    }
    
    // Pterodactyl
    $panelUrl = getenv('PTERODACTYL_URL');
    if ($panelUrl) {
        $ch = curl_init($panelUrl);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_TIMEOUT, 5);
        curl_exec($ch);
        $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);
        $status = $httpCode === 200 ? color('✅ En ligne', 'green') : color('❌ Hors ligne', 'red');
        line(color('Pterodactyl', 'yellow') . ' : ' . $status);
    }
    
    // Disk
    $free = disk_free_space('/');
    $total = disk_total_space('/');
    $used = 100 - (($free / $total) * 100);
    $color = $used > 90 ? 'red' : ($used > 70 ? 'yellow' : 'green');
    line(color('Disque', 'yellow') . '     : ' . color(number_format($used, 1) . '% utilisé', $color) . ' (' . formatBytes($free) . ' libre)');
    
    line();
    line(color('Environnement : ', 'gray') . (getenv('APP_ENV') ?: 'production'));
    line(color('Debug         : ', 'gray') . (getenv('APP_DEBUG') ?: 'false'));
}