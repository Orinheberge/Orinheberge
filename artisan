// ═══════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════
function getPdo() {
    static $pdo = null;
    if ($pdo === null) {
        $pdo = new PDO(
            sprintf('mysql:host=%s;port=%s;dbname=%s;charset=%s',
                getenv('DB_HOST'), getenv('DB_PORT'),
                getenv('DB_DATABASE'), getenv('DB_CHARSET')
            ),
            getenv('DB_USERNAME'), getenv('DB_PASSWORD'),
            [
                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC
            ]
        );
    }
    return $pdo;
}

function ensureStorageDir() {
    $dir = BASE_PATH . '/storage/framework';
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }
    return $dir;
}

// ═══════════════════════════════════════════
// COMMANDES EXISTANTES
// ═══════════════════════════════════════════

function cmdKeyGenerate() {
    info('Génération d\'une clé de chiffrement...');
    $key = 'base64:' . base64_encode(random_bytes(32));
    $envFile = BASE_PATH . '/.env';
    $content = file_get_contents($envFile);
    
    if (strpos($content, 'ENCRYPTION_KEY=') !== false) {
        $content = preg_replace('/ENCRYPTION_KEY=.*/', 'ENCRYPTION_KEY=' . $key, $content);
    } else {
        $content .= "\nENCRYPTION_KEY=" . $key . "\n";
    }
    file_put_contents($envFile, $content);
    success("Clé générée et sauvegardée dans .env");
}

function cmdDbMigrate() {
    info('Exécution des migrations...');
    $pdo = getPdo();
    $migrationsPath = BASE_PATH . '/database/migrations';
    if (!is_dir($migrationsPath)) {
        mkdir($migrationsPath, 0755, true);
        warning('Dossier migrations créé');
        return;
    }
    
    $pdo->exec("CREATE TABLE IF NOT EXISTS migrations (
        id INT AUTO_INCREMENT PRIMARY KEY,
        migration VARCHAR(255) UNIQUE,
        executed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    )");
    
    $executed = $pdo->query("SELECT migration FROM migrations")->fetchAll(PDO::FETCH_COLUMN);
    $files = glob($migrationsPath . '/*.sql');
    sort($files);
    $count = 0;
    
    foreach ($files as $file) {
        $name = basename($file);
        if (in_array($name, $executed)) {
            line(color("⏭️  ", 'gray') . color($name, 'gray') . ' (déjà exécuté)');
            continue;
        }
        info("Migration : $name");
        try {
            $pdo->exec(file_get_contents($file));
            $pdo->prepare("INSERT INTO migrations (migration) VALUES (?)")->execute([$name]);
            success("✅ $name");
            $count++;
        } catch (Exception $e) {
            error("❌ $name : " . $e->getMessage());
            exit(1);
        }
    }
    line();
    success("$count migration(s) exécutée(s)");
}

function cmdDbSeed() {
    info('Remplissage de la BDD...');
    $pdo = getPdo();
    $seedsPath = BASE_PATH . '/database/seeds';
    if (!is_dir($seedsPath)) { warning('Dossier seeds introuvable'); return; }
    foreach (glob($seedsPath . '/*.sql') as $file) {
        $name = basename($file);
        info("Seed : $name");
        $pdo->exec(file_get_contents($file));
        success("✅ $name");
    }
}

function cmdDbBackup() {
    info('Sauvegarde de la BDD...');
    $backupPath = getenv('BACKUP_PATH') ?: BASE_PATH . '/backups';
    if (!is_dir($backupPath)) mkdir($backupPath, 0755, true);
    $filename = 'backup_' . date('Y-m-d_H-i-s') . '.sql';
    $filepath = $backupPath . '/' . $filename;
    $cmd = sprintf(
        'mysqldump -h%s -P%s -u%s -p%s %s > %s 2>&1',
        escapeshellarg(getenv('DB_HOST')), escapeshellarg(getenv('DB_PORT')),
        escapeshellarg(getenv('DB_USERNAME')), escapeshellarg(getenv('DB_PASSWORD')),
        escapeshellarg(getenv('DB_DATABASE')), escapeshellarg($filepath)
    );
    exec($cmd, $output, $return);
    if ($return === 0) {
        success("Sauvegarde : $filename (" . formatBytes(filesize($filepath)) . ")");
    } else {
        error('Erreur : ' . implode("\n", $output));
    }
}

function cmdDbRestore($file) {
    if (!$file) { error('Usage: php artisan db:restore <file.sql>'); exit(1); }
    $backupPath = getenv('BACKUP_PATH') ?: BASE_PATH . '/backups';
    $filepath = $backupPath . '/' . $file;
    if (!file_exists($filepath)) { error("Fichier introuvable : $file"); exit(1); }
    
    warning("⚠️  ATTENTION : Cette action va ÉCRASER la BDD actuelle !");
    echo "Continuer ? (yes/no) : ";
    if (strtolower(trim(fgets(STDIN))) !== 'yes') { warning('Annulé'); return; }
    
    $cmd = sprintf(
        'mysql -h%s -P%s -u%s -p%s %s < %s 2>&1',
        escapeshellarg(getenv('DB_HOST')), escapeshellarg(getenv('DB_PORT')),
        escapeshellarg(getenv('DB_USERNAME')), escapeshellarg(getenv('DB_PASSWORD')),
        escapeshellarg(getenv('DB_DATABASE')), escapeshellarg($filepath)
    );
    exec($cmd, $output, $return);
    if ($return === 0) success('Restauration terminée !');
    else error('Erreur : ' . implode("\n", $output));
}

function cmdUserCreate() {
    line(color('╔══════════════════════════════════════╗', 'cyan'));
    line(color('║  Création d\'un utilisateur admin     ║', 'white'));
    line(color('╚══════════════════════════════════════╝', 'cyan'));
    line();
    
    echo "Email : "; $email = trim(fgets(STDIN));
    echo "Pseudo : "; $pseudo = trim(fgets(STDIN));
    echo "Prénom : "; $firstname = trim(fgets(STDIN));
    echo "Nom : "; $lastname = trim(fgets(STDIN));
    echo "Mot de passe : ";
    system('stty -echo'); $password = trim(fgets(STDIN)); system('stty echo'); line();
    
    if (!$email || !$password) { error('Email et mot de passe requis'); return; }
    
    $pdo = getPdo();
    $check = $pdo->prepare("SELECT id FROM users WHERE email = ?");
    $check->execute([$email]);
    if ($check->fetch()) { error("Utilisateur déjà existant"); return; }
    
    $hash = password_hash($password, PASSWORD_DEFAULT);
    $pdo->prepare("INSERT INTO users (email, pseudo, firstname, lastname, password, is_admin, created_at) VALUES (?, ?, ?, ?, ?, 1, NOW())")
        ->execute([$email, $pseudo, $firstname, $lastname, $hash]);
    
    success("✅ Utilisateur créé !");
    line("   ID : " . $pdo->lastInsertId());
}

function cmdUserResetPassword() {
    echo "Email : "; $email = trim(fgets(STDIN));
    echo "Nouveau mot de passe : ";
    system('stty -echo'); $password = trim(fgets(STDIN)); system('stty echo'); line();
    
    if (strlen($password) < 8) { error('Min. 8 caractères'); return; }
    
    $pdo = getPdo();
    $hash = password_hash($password, PASSWORD_DEFAULT);
    $stmt = $pdo->prepare("UPDATE users SET password = ? WHERE email = ?");
    $stmt->execute([$hash, $email]);
    
    if ($stmt->rowCount() > 0) success("✅ Mot de passe réinitialisé");
    else error("Utilisateur introuvable");
}

function cmdCacheClear() {
    info('Vidage du cache...');
    $count = 0;
    foreach ([BASE_PATH . '/cache', BASE_PATH . '/storage/cache', '/tmp/orinheberge'] as $dir) {
        if (!is_dir($dir)) continue;
        foreach (glob($dir . '/*') as $file) {
            if (is_file($file)) { unlink($file); $count++; }
        }
    }
    success("✅ $count fichier(s) supprimé(s)");
}

function cmdLogsClear() {
    info('Vidage des logs...');
    $logPath = getenv('LOG_PATH') ?: BASE_PATH . '/logs';
    if (!is_dir($logPath)) { warning('Dossier introuvable'); return; }
    $count = 0;
    foreach (glob($logPath . '/*.log') as $file) { unlink($file); $count++; }
    success("✅ $count fichier(s) supprimé(s)");
}

function cmdServersSync() {
    info('Sync Pterodactyl...');
    $pdo = getPdo();
    $panelUrl = getenv('PTERODACTYL_URL');
    $apiKey = getenv('PTERODACTYL_ADMIN_KEY');
    if (!$panelUrl || !$apiKey) { error('Config manquante'); return; }
    
    $ch = curl_init("$panelUrl/api/application/servers");
    curl_setopt_array($ch, [
        CURLOPT_HTTPHEADER => ["Authorization: Bearer $apiKey", "Accept: application/vnd.pterodactyl.v1+json"],
        CURLOPT_RETURNTRANSFER => true, CURLOPT_TIMEOUT => 30
    ]);
    $response = curl_exec($ch);
    curl_close($ch);
    
    $data = json_decode($response, true);
    if (!isset($data['data'])) { error('Erreur API'); return; }
    
    $panelServers = $data['data'];
    $localUuids = array_column($pdo->query("SELECT uuid FROM orders")->fetchAll(), 'uuid');
    
    $synced = 0; $missing = 0;
    foreach ($panelServers as $ps) {
        $uuid = $ps['attributes']['uuid'] ?? '';
        if (in_array($uuid, $localUuids)) $synced++;
        else { $missing++; warning("Non trouvé : " . ($ps['attributes']['name'] ?? $uuid)); }
    }
    success("✅ $synced synchronisé(s)");
    if ($missing > 0) warning("⚠️  $missing absent(s) en BDD");
}

function cmdMaintenance($mode) {
    $pdo = getPdo();
    if ($mode === 'on') {
        $pdo->exec("INSERT INTO maintenance (title, description, severity, status, is_active, is_public, start_date, end_date) VALUES ('Maintenance', 'Maintenance en cours', 'warning', 'in_progress', 1, 1, NOW(), DATE_ADD(NOW(), INTERVAL 1 HOUR))");
        success("🔧 Maintenance ACTIVÉE");
    } else {
        $pdo->exec("UPDATE maintenance SET is_active = 0 WHERE is_active = 1");
        success("✅ Maintenance DÉSACTIVÉE");
    }
}

