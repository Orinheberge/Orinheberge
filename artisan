#!/usr/bin/env php
<?php
/**
 * ═══════════════════════════════════════════════════════════
 * OrinHeberge Artisan CLI
 * ═══════════════════════════════════════════════════════════
 * Usage : php artisan <command> [options]
 */

define('BASE_PATH', __DIR__);
define('ARTISAN_VERSION', '1.1.0');
define('DOWN_FILE', BASE_PATH . '/storage/framework/down');

// ═══════════════════════════════════════════
// BOOTSTRAP
// ═══════════════════════════════════════════
if (!file_exists(BASE_PATH . '/.env')) {
    fwrite(STDERR, "\033[31m❌ Fichier .env introuvable. Copiez .env.example vers .env\033[0m\n");
    exit(1);
}

$env = [];
foreach (file(BASE_PATH . '/.env') as $line) {
    $line = trim($line);
    if ($line === '' || $line[0] === '#') continue;
    if (strpos($line, '=') === false) continue;
    [$key, $value] = explode('=', $line, 2);
    $env[trim($key)] = trim($value);
    putenv(trim($key) . '=' . trim($value));
}

// ═══════════════════════════════════════════
// COULEURS & HELPERS
// ═══════════════════════════════════════════
function color($text, $color) {
    $colors = [
        'red' => '31', 'green' => '32', 'yellow' => '33',
        'blue' => '34', 'magenta' => '35', 'cyan' => '36',
        'white' => '37', 'gray' => '90', 'bold' => '1'
    ];
    return "\033[" . ($colors[$color] ?? '37') . "m{$text}\033[0m";
}

function info($msg)    { echo color("ℹ ", 'cyan') . $msg . "\n"; }
function success($msg) { echo color("✅ ", 'green') . $msg . "\n"; }
function warning($msg) { echo color("⚠️ ", 'yellow') . $msg . "\n"; }
function error($msg)   { echo color("❌ ", 'red') . $msg . "\n"; }
function line($msg = '') { echo $msg . "\n"; }

function formatBytes($bytes, $precision = 2) {
    $units = ['B', 'KB', 'MB', 'GB', 'TB'];
    $bytes = max($bytes, 0);
    $pow = floor(($bytes ? log($bytes) : 0) / log(1024));
    $pow = min($pow, count($units) - 1);
    $bytes /= (1 << (10 * $pow));
    return round($bytes, $precision) . ' ' . $units[$pow];
}

// ═══════════════════════════════════════════
// ROUTER
// ═══════════════════════════════════════════
$args = $argv;
array_shift($args);

if (empty($args)) {
    showHelp();
    exit(0);
}

$command = $args[0];
$params  = array_slice($args, 1);
$options = [];

// Parser les options --key=value ou --key value
for ($i = 0; $i < count($params); $i++) {
    if (strpos($params[$i], '--') === 0) {
        $opt = substr($params[$i], 2);
        if (strpos($opt, '=') !== false) {
            [$k, $v] = explode('=', $opt, 2);
            $options[$k] = $v;
        } elseif (isset($params[$i + 1]) && strpos($params[$i + 1], '--') !== 0) {
            $options[$opt] = $params[$i + 1];
            $i++;
        } else {
            $options[$opt] = true;
        }
    }
}

try {
    switch ($command) {
        case 'key:generate':       cmdKeyGenerate(); break;
        case 'db:migrate':         cmdDbMigrate(); break;
        case 'db:seed':            cmdDbSeed(); break;
        case 'db:backup':          cmdDbBackup(); break;
        case 'db:restore':         cmdDbRestore($params[0] ?? null); break;
        case 'user:create':        cmdUserCreate(); break;
        case 'user:reset-password': cmdUserResetPassword(); break;
        case 'cache:clear':        cmdCacheClear(); break;
        case 'logs:clear':         cmdLogsClear(); break;
        case 'servers:sync':       cmdServersSync(); break;
        case 'maintenance:on':     cmdMaintenance('on'); break;
        case 'maintenance:off':    cmdMaintenance('off'); break;
        case 'down':               cmdDown($options); break;
        case 'up':                 cmdUp(); break;
        case 'status':             cmdStatus(); break;
        case 'help':
        case '--help':
        case '-h':
            showHelp();
            break;
        default:
            error("Commande inconnue : $command");
            line();
            showHelp();
            exit(1);
    }
} catch (Throwable $e) {
    error("Erreur : " . $e->getMessage());
    if (getenv('APP_DEBUG') === 'true') {
        line($e->getTraceAsString());
    }
    exit(1);
}

